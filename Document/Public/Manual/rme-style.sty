%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% rme-style.sty -- Layout and typography for the M7M01 (RME) User Manual
%
% The visual language follows the RISC-V Instruction Set Manual: Montserrat
% for display/headings, Petrona for body text, JetBrains Mono for code, a
% restrained purple accent, generous A4 margins, and thin rules instead of
% heavy boxes.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rme-style}[2026/11/03 RME User Manual style]

% --------------------------------------------------------------------------
% Page geometry and fonts
% --------------------------------------------------------------------------
\RequirePackage[a4paper,top=30mm,bottom=32mm,left=28mm,right=28mm,
                headheight=20pt,headsep=8mm,footskip=15mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{Petrona}[
  Path=../Font/, Extension=.ttf,
  UprightFont=Petrona-Light,
  BoldFont=Petrona-Medium,
  ItalicFont=Petrona-LightItalic,
  BoldItalicFont=Petrona-MediumItalic,
  Ligatures=TeX
]
\setsansfont{Montserrat}[
  Path=../Font/, Extension=.ttf,
  UprightFont=Montserrat-Light,
  BoldFont=Montserrat-Medium,
  ItalicFont=Montserrat-LightItalic,
  BoldItalicFont=Montserrat-MediumItalic,
  Ligatures=TeX
]
\setmonofont{JetBrainsMono}[
  Path=../Font/, Extension=.ttf,
  UprightFont=JetBrainsMono-Regular,
  BoldFont=JetBrainsMono-Bold,
  Scale=0.86
]
\setmathfont{Latin Modern Math}
\RequirePackage{newunicodechar}
\newunicodechar{μ}{\ensuremath{\mu}}

% CJK support: the English edition keeps the bilingual terminology table
\RequirePackage{xeCJK}
\setCJKmainfont{Noto Sans CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
\setCJKmonofont{Noto Sans Mono CJK SC}
\xeCJKsetup{CJKmath=true}

\linespread{1.10}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0.15em plus 0.05em minus 0.05em}
\setlength{\emergencystretch}{3em}
\tolerance=1000
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
\renewcommand{\thetable}{\thechapter-\arabic{table}}
\renewcommand{\thefigure}{\thechapter-\arabic{figure}}
\raggedbottom
\interfootnotelinepenalty=10000

% --------------------------------------------------------------------------
% Colour palette
% --------------------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{rmepurple}{HTML}{5B2A86}
\definecolor{rmegold}{HTML}{E8A317}
\definecolor{rmegray}{HTML}{3C3C43}
\definecolor{rmemid}{HTML}{6E6E78}
\definecolor{rmelight}{HTML}{F5F1FA}
\definecolor{rmerule}{HTML}{D8D0E6}
\definecolor{rmegreen}{HTML}{2E7D32}
\definecolor{rmered}{HTML}{B3261E}
\definecolor{codebg}{HTML}{F7F7F9}

% --------------------------------------------------------------------------
% Running headers and footers
% --------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rmerule}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[LE]{\sffamily\footnotesize\color{rmemid}\leftmark}
\fancyhead[RO]{\sffamily\footnotesize\color{rmemid}\rightmark}
\fancyfoot[LE,RO]{\sffamily\footnotesize\color{rmemid}\thepage}
\fancyfoot[RE,LO]{\sffamily\footnotesize\color{rmemid}M7M01 (RME) Technical Reference Manual}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\small\color{rmemid}\thepage}%
}

\renewcommand{\chaptermark}[1]{\markboth{Chapter \thechapter{} $\mid$ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{Section \thesection{} $\mid$ #1}}

% --------------------------------------------------------------------------
% Chapter, section, and part headings
% --------------------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\chapter}[hang]
  {\normalfont\sffamily\fontsize{22}{26}\selectfont\bfseries\color{rmegray}}
  {\color{rmepurple}\thechapter.\quad}{0pt}{}
  [\vspace{0.45em}{\color{rmerule}\rule{\textwidth}{0.7pt}}]
\titlespacing*{\chapter}{0pt}{6pt}{26pt}

\titleformat{name=\chapter,numberless}[hang]
  {\normalfont\sffamily\fontsize{22}{26}\selectfont\bfseries\color{rmegray}}
  {}{0pt}{}
  [\vspace{0.45em}{\color{rmerule}\rule{\textwidth}{0.7pt}}]
\titlespacing*{\chapter}{0pt}{6pt}{26pt}

\titleformat{\section}[hang]
  {\normalfont\sffamily\Large\bfseries\color{rmegray}}
  {\color{rmepurple}\thesection\quad}{0pt}{}
\titlespacing*{\section}{0pt}{18pt plus 3pt minus 3pt}{7pt}

\titleformat{\subsection}[hang]
  {\normalfont\sffamily\large\itshape\color{rmegray}}
  {\color{rmepurple}\thesubsection\quad}{0pt}{}
\titlespacing*{\subsection}{0pt}{13pt plus 2pt minus 2pt}{5pt}

\titleformat{\subsubsection}[hang]
  {\normalfont\sffamily\normalsize\bfseries\color{rmegray}}
  {\color{rmepurple}\thesubsubsection\quad}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt minus 1pt}{3pt}

\titleformat{\part}[display]
  {\normalfont\sffamily\raggedright}
  {\fontsize{42}{46}\selectfont\color{rmepurple!35}\thepart}
  {0.6em}
  {\fontsize{26}{30}\selectfont\bfseries\color{rmegray}}
  [\vspace{0.6em}{\color{rmerule}\rule{\textwidth}{0.8pt}}]
\titlespacing*{\part}{0pt}{40pt}{30pt}

% --------------------------------------------------------------------------
% Table of contents and lists
% --------------------------------------------------------------------------
\RequirePackage{titletoc}
\renewcommand{\contentsname}{Contents}
\renewcommand{\listfigurename}{List of Figures}
\renewcommand{\listtablename}{List of Tables}
\renewcommand{\bibname}{References}
\titlecontents{chapter}[0pt]
  {\addvspace{5pt}\sffamily\bfseries\color{rmegray}}
  {\contentslabel{2.5em}}{}{\hfill\contentspage}
\titlecontents{section}[2.5em]
  {\sffamily\normalsize\color{rmegray}}
  {\contentslabel{2.5em}}{}{\titlerule*[0.55pc]{.}\contentspage}
\titlecontents{subsection}[5.0em]
  {\sffamily\small\color{rmemid}}
  {\contentslabel{2.8em}}{}{\titlerule*[0.55pc]{.}\contentspage}

% --------------------------------------------------------------------------
% Tables, captions, lists, floats
% --------------------------------------------------------------------------
\RequirePackage{calc}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{xltabular}
\RequirePackage{colortbl}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{caption}
\renewcommand{\tablename}{Table}
\renewcommand{\figurename}{Figure}
\makeatletter
\renewcommand*\l@table{\@dottedtocline{1}{0em}{3.6em}}
\renewcommand*\l@figure{\@dottedtocline{1}{0em}{3.6em}}
\makeatother
\captionsetup{
  font={small,sf},
  labelfont={bf,color=rmepurple},
  labelsep=space,
  justification=raggedright,
  singlelinecheck=false
}
\RequirePackage{subcaption}
\RequirePackage{float}
\RequirePackage[section]{placeins}
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.5em,itemsep=2pt,topsep=3pt}
\setlist[enumerate]{leftmargin=1.8em,itemsep=2pt,topsep=3pt}
\setlist[description]{leftmargin=1.4em,style=nextline,itemsep=1pt,topsep=3pt}

% --------------------------------------------------------------------------
% Code listings
% --------------------------------------------------------------------------
\RequirePackage{listings}
\lstdefinestyle{rmecode}{
  language=C,
  basicstyle=\ttfamily\footnotesize\color{rmegray},
  backgroundcolor=\color{codebg},
  keywordstyle=\color{rmepurple}\bfseries,
  commentstyle=\color{rmemid}\itshape,
  stringstyle=\color{rmegold!85!black},
  numberstyle=\ttfamily\scriptsize\color{rmemid!60},
  numbers=left,
  numbersep=8pt,
  frame=none,
  framesep=4pt,
  rulecolor=\color{rmerule},
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=4,
  xleftmargin=16pt,
  xrightmargin=2pt,
  aboveskip=8pt,
  belowskip=8pt,
  literate={->}{{$\rightarrow$}}1 {<-}{{$\leftarrow$}}1
}
\lstset{style=rmecode}

% --------------------------------------------------------------------------
% Callout boxes
% --------------------------------------------------------------------------
\RequirePackage[most]{tcolorbox}
\newtcolorbox{notebox}[1][]{
  enhanced, breakable,
  colback=rmelight, colframe=rmepurple!55,
  boxrule=0pt, leftrule=2.2pt, arc=0pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fontupper=\small,
  #1
}
\newtcolorbox{warnbox}[1][]{
  enhanced, breakable,
  colback=red!3!white, colframe=rmered,
  boxrule=0pt, leftrule=2.2pt, arc=0pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fontupper=\small,
  #1
}
\newtcolorbox{tipbox}[1][]{
  enhanced, breakable,
  colback=green!3!white, colframe=rmegreen,
  boxrule=0pt, leftrule=2.2pt, arc=0pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fontupper=\small,
  #1
}

% --------------------------------------------------------------------------
% API documentation boxes
% --------------------------------------------------------------------------
\RequirePackage{needspace}
\newtcolorbox{apidesc}[2]{
  enhanced, breakable,
  colback=white, colframe=rmerule,
  boxrule=0.5pt, arc=1pt,
  left=9pt, right=9pt, top=8pt, bottom=8pt,
  before skip=8pt, after skip=8pt,
  fontupper=\normalsize,
  before upper={\par\noindent
    {\sffamily\bfseries\large\color{rmepurple}#1}\hfill
    {\sffamily\small\color{rmemid}#2}\par
    \vspace{1pt}{\color{rmerule}\hrule height 0.4pt}\vspace{3pt}}
}
\newcommand{\apisig}[1]{%
  \par\vspace{2pt}\noindent
  \begin{tcolorbox}[colback=rmelight,colframe=rmelight,boxrule=0pt,arc=1pt,
                    left=6pt,right=6pt,top=4pt,bottom=4pt]
  \ttfamily\small #1
  \end{tcolorbox}
}
\newenvironment{apiparams}{%
  \par\vspace{2pt}\noindent{\sffamily\bfseries\color{rmegray}Parameters}%
  \begin{description}[leftmargin=0pt,labelindent=0pt,style=nextline,
                      itemsep=2pt,topsep=3pt,parsep=0pt]%
}{%
  \end{description}%
}
\newenvironment{apiret}{%
  \par\vspace{2pt}\noindent{\sffamily\bfseries\color{rmegray}Return Values}%
  \begin{description}[leftmargin=0pt,labelindent=0pt,style=nextline,
                      itemsep=2pt,topsep=3pt,parsep=0pt]%
}{%
  \end{description}%
}
\newcommand{\apiparam}[2]{\item[\texttt{\small #1}] #2}
\newcommand{\apiretval}[2]{\item[\texttt{\small #1}] #2}


% --------------------------------------------------------------------------
% Misc
% --------------------------------------------------------------------------
\RequirePackage{etoolbox}
\RequirePackage{pdflscape}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,calc,fit,
                backgrounds,patterns,decorations.pathreplacing}
\RequirePackage[hidelinks]{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=rmepurple,
  citecolor=rmepurple,
  urlcolor=rmepurple,
  filecolor=rmepurple,
  linktoc=none,
  pdfauthor={EDI-Systems},
  pdftitle={M7M01 (Eukaron) R4T1 Microkernel General-Purpose Real-Time Operating System (Rev.4 Typ.1) Technical Reference Manual},
  pdfsubject={User manual for the M7M01 (RME) real-time operating system,
               version R4T1},
  pdfkeywords={RTOS, RME, M7M01, Eukaron, embedded, real-time, EDI-Systems},
  bookmarks=true,
  bookmarksnumbered=true,
  bookmarksopen=true,
  bookmarksopenlevel=1,
  bookmarksdepth=2
}
\RequirePackage{makeidx}
\makeindex


% Keep footnotes quiet
\renewcommand{\footnoterule}{\vspace*{-3pt}{\color{rmerule}\hrule width 0.4\textwidth height 0.4pt}\vspace*{2.6pt}}
\setlength{\skip\footins}{10pt plus 4pt minus 2pt}

% --------------------------------------------------------------------------
% Reusable table styles
% --------------------------------------------------------------------------
\RequirePackage{xparse}
\RequirePackage{fontawesome5}

% Positive/negative markers for the Locked and ISR columns.
\newcommand{\cmark}{\textcolor{rmegreen}{\faCheck}}
\newcommand{\xmark}{\textcolor{rmered}{\faTimes}}

% Table header cell.
\newcommand{\tablehead}[1]{\textbf{\textsf{\color{rmepurple}#1}}}

% API summary table: Function / Purpose / Locked / ISR.
% Usage: \begin{apisummarytable}[placement]{caption}{label} ... rows ... \end{apisummarytable}
\NewDocumentEnvironment{apisummarytable}{O{htbp} m m +b}
{%
  \begin{table}[#1]
  \centering
  \caption{#2}
  \label{#3}
  \small
  \begin{tabularx}{\textwidth}{@{}>{\ttfamily}p{3.6cm}>{\raggedright\arraybackslash}Xcc@{}}
  \toprule
  \tablehead{Function} & \tablehead{Purpose} &
  \tablehead{Locked} & \tablehead{ISR} \\
  \midrule
  #4
  \bottomrule
  \end{tabularx}
  \end{table}
}
{}

% Return-code table: Value / No. / Meaning.
% Usage: \begin{returncodetable}[placement]{caption}{label} ... rows ... \end{returncodetable}
\NewDocumentEnvironment{returncodetable}{O{htbp} m m +b}
{%
  \begin{table}[#1]
  \centering
  \caption{#2}
  \label{#3}
  \small
  \begin{tabularx}{\textwidth}{@{}>{\ttfamily}p{3.6cm}rX@{}}
  \toprule
  \tablehead{Value} & \tablehead{No.} &
  \tablehead{Meaning} \\
  \midrule
  #4
  \bottomrule
  \end{tabularx}
  \end{table}
}
{}

\newcounter{none}

\endinput

